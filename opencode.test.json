{
  "$schema": "./.schemas/opencode.config.schema.json",
  "autoupdate": false,
  "formatter": {
    "custom-prettier": {
      "command": [
        "npx",
        "prettier",
        "--write",
        "$FILE"
      ],
      "environment": {
        "NODE_ENV": "development"
      },
      "extensions": [
        ".js",
        ".ts",
        ".jsx",
        ".tsx"
      ]
    },
    "prettier": {
      "disabled": true
    }
  },
